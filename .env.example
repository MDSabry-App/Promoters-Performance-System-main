# Neon pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1"
# Neon direct connection (used by prisma db push / migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
ADMIN_PASSWORD="change-this"
AUTH_SECRET="replace-with-long-random-secret"

# Web Push (PWA / browser) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Firebase Cloud Messaging for the Android APK (JSON string of the service-account key)
# Only needed for background push when the app is fully closed. Copy the JSON from
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Without it the app still notifies you about every change while it is open/backgrounded.
# FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Optional: override the live URL the Capacitor WebView loads
# CAPACITOR_SERVER_URL="https://promoters-performance-system-eta.vercel.app/"
